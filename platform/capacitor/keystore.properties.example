# Template. Copy to keystore.properties (git-ignored) and fill in.
#
#   cp keystore.properties.example keystore.properties
#
# ⚠️ WHICH KEY. Play registered ONE upload certificate and rejects a
# bundle signed with anything else. It is:
#
#     platform/android-twa/pwab/signing.keystore, alias my-key-alias
#     SHA-256 01:1A:73:4E:76:F1:86:C9:A2:5C:91:3C:3C:DA:D6:F8:
#             39:57:5A:04:4B:24:A6:D0:E0:20:52:85:F3:7B:A6:A6
#
# It is NOT platform/android-twa/android.keystore, and it is NOT the
# certificate in upload-certificate.pem — despite the name, that .pem is
# android.keystore's cert (SHA-256 E6:38:C8:…), which the secrets file
# records as superseded. Signing with it fails at upload.
#
# The passwords are in platform/android-twa/keystore-secrets.DO-NOT-COMMIT.txt.
# Both files are git-ignored; neither belongs in a password-less repo whose
# root is served at crema-app.com.

# Relative to platform/capacitor/android/app/
storeFile=../../../android-twa/pwab/signing.keystore
storePassword=
keyAlias=my-key-alias
keyPassword=
