.DS_Store
*.log
.vscode/
.idea/
node_modules/
platform/supabase/.temp/
# the same folder, created at the ROOT by running the Supabase CLI from here
# instead of from platform/. Holds the project ref and organisation id, and the
# root is the web root — so an untracked one would be published by `git add -A`.
/supabase/

# internal planning document. Untracked since it was written; this keeps it that
# way, because the repo root is served at crema-app.com. Delete this line to publish it.
STRATEGY.md

# machine-local Claude Code hooks (absolute paths to this Mac's tooling)
.claude/settings.json

# brand, marketing and go-to-market material — kept out of a public repo,
# which is also the web root: anything committed here is served at crema-app.com
business/

# generated code graph (graphify) — machine-local, rebuild with `graphify update .`
graphify-out/
.cograph/

# Android TWA (Play Store wrapper) — signing key and build output never get committed
# signing material — matched at any depth, these are credentials
*.keystore
*.jks
*.pem
platform/android-twa/**/keystore-secrets.DO-NOT-COMMIT.txt
platform/android-twa/**/signing-key-info.txt
platform/android-twa/local.properties
platform/android-twa/.gradle/
platform/android-twa/app/build/
platform/android-twa/build/
platform/android-twa/*.aab
platform/android-twa/*.apk
platform/android-twa/*.idsig

# unzipped AAB module, left behind when inspecting a bundle
platform/android-twa/base/

# Playwright (e2e/) — everything a run produces, none of which belongs in a
# repo whose root is the web root. .auth/ is the one that matters: it holds
# the throwaway staging accounts' passwords and their live session tokens.
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# Capacitor shell (platform/capacitor/) — step 4.1.
#
# www/ is GENERATED: `node platform/capacitor/sync.mjs` stages the web
# app into it from the same rules that build sw.js's precache list. It is
# ignored for the reason every generated directory is, and for one more
# that is specific to this repo — the root is the web root, so a
# committed www/ would publish a second, silently diverging copy of the
# entire app at crema-app.com/platform/capacitor/www/.
platform/capacitor/www/
platform/capacitor/node_modules/

# The native projects. `npx cap add ios|android` regenerates both from
# capacitor.config.json and package.json, and they hold absolute paths,
# Pods/, build output and (on iOS) the team id. What must be kept by hand
# is tracked deliberately: see platform/capacitor/README.md.
platform/capacitor/ios/
platform/capacitor/android/

# Signing material, again, matched under the new directory too. The
# patterns above are already depth-independent; this is here so that
# deleting one of them does not quietly widen the blast radius.
platform/capacitor/**/*.keystore
platform/capacitor/**/*.p8
platform/capacitor/**/*.p12
platform/capacitor/**/GoogleService-Info.plist
platform/capacitor/**/google-services.json

# The Play upload key's passwords, read by android/app/build.gradle.
# keystore.properties.example is the tracked template; this is the real
# one and it must never be committed — the repo root is the web root, so
# a committed copy would be downloadable from crema-app.com.
platform/capacitor/keystore.properties
