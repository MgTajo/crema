# Android TWA (Play Store wrapper) — signing key and build output never get committed
# signing material — matched at any depth, these are credentials
*.keystore
*.jks
*.pem
android-twa/**/keystore-secrets.DO-NOT-COMMIT.txt
android-twa/**/signing-key-info.txt
android-twa/local.properties
android-twa/.gradle/
android-twa/app/build/
android-twa/build/
android-twa/*.aab
android-twa/*.apk
android-twa/*.idsig
